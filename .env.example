# Copy to server/.env and fill in. Never commit the real .env.
# Neon Postgres (https://neon.com). Use the *pooled* URL for the app...
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/bookleaf?sslmode=require
# ...and the *direct* URL (same host without "-pooler") for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/bookleaf?sslmode=require
# Offline alternative: `npm run db:up` and use
# postgresql://bookleaf:bookleaf@localhost:5432/bookleaf for both.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Optional: without it, AI features degrade to rule-based fallbacks.
OPENAI_API_KEY=
